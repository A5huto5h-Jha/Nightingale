# Core Configuration
PROJECT_NAME="PulseCare Backend API"
ENVIRONMENT="development"
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_HERE"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_USER=pulsecare_user
POSTGRES_PASSWORD=pulsecare_password
POSTGRES_DB=pulsecare_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pulsecare_user:pulsecare_password@localhost:5432/pulsecare_db

# Redis Caching & Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Payment Integration (UPI Gateway - Razorpay/Cashfree)
PAYMENT_GATEWAY_KEY=your_api_key_here
PAYMENT_GATEWAY_SECRET=your_api_secret_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# AI Diagnostic Triage API
OPENAI_API_KEY=your_openai_key_here

# SMS / WhatsApp Notification Services (Twilio / MSG91)
NOTIFICATION_API_KEY=your_notification_key_here
